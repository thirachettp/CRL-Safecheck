# ฐานข้อมูล (Neon) — ใช้ connection string แบบ pooled
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# รหัส Admin ตั้งต้น (ตัวเลข 4–8 หลัก) ใช้เข้าหน้าตั้งค่าครั้งแรก เพื่อเพิ่มผู้ยืนยันและตั้งรหัสรายคน
# บัญชี admin ในตัว: เข้าด้วยชื่อ ADMIN_USER (ค่าตั้งต้น admin) + รหัสผ่าน ADMIN_PASSWORD · ลบออก = ปิดบัญชีนี้
ADMIN_USER=admin
ADMIN_PASSWORD=
# รหัสพนักงานที่เป็น Admin เสมอ (เปิด Admin คนแรก) คั่นด้วย comma
ADMIN_CODES=
# PIN สำรอง (ระบบเดิม) ใช้ได้ถ้ายังไม่มีบัญชี Admin
ADMIN_PIN=
# ข้อความสุ่มยาว ใช้เซ็น token หลังใส่รหัส Admin / Safety
SESSION_SECRET=

# ป้องกันทั้งเว็บด้วยรหัสผ่าน (เว้นว่าง = ไม่ป้องกัน ห้ามเว้นว่างบน production)
APP_USER=safecheck
APP_PASSWORD=

# Vercel ใส่ให้อัตโนมัติเมื่อเปิด Cron — ตั้งเองได้
CRON_SECRET=

# เส้น MS Form แบบ non-premium: ดึงจาก SharePoint List ผ่าน Graph (รอ app registration จาก IT)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SP_SITE=centralgroup.sharepoint.com:/sites/CDSBangnaWarehouse
SP_DIV_LIST=SafeCheck_DIV_CheckIn
# ถ้าชื่อ internal ของคอลัมน์ใน list ไม่ตรง ใส่ mapping เป็น JSON
# SP_FIELD_MAP={"response_id":"ResponseId","email":"Email","full_name":"FullName","gender":"Gender","site":"Site","submitted_at":"SubmittedAt"}

# เส้น MS Form แบบ Premium: Power Automate ยิง POST /api/ingest/div พร้อม X-Sync-Token
INGEST_TOKEN_DIV=

# เส้น Driver (KIOS) — เรียก RPC ตรง แทนการผ่าน Power BI ใช้ทะเบียนรถเป็นตัวระบุคน
KIOS_BASE_URL=https://dbadmin-centralhw.dollysolutions.com
# apikey ของ KIOS เก็บฝั่ง server เท่านั้น ห้ามใส่ในโค้ดหน้าเว็บ
KIOS_API_KEY=
KIOS_RPC=vms_dpark_withtransaction_detail
KIOS_STATUS_ID=2
# ค่า Body ที่สูตร Power Query ส่งไป เป็น JSON ใส่ {{today}} {{yesterday}} {{tomorrow}} {{now}} แทนวันที่ได้
# KIOS ใช้: {"p_app_id":34,"startdatetime":"{{yesterday}}T00:00:00","enddatetime":"{{today}}T23:59:59"}
KIOS_RPC_BODY={"p_app_id":34,"startdatetime":"{{yesterday}}T00:00:00","enddatetime":"{{today}}T23:59:59"}
# ถ้าระบบจับคอลัมน์ผิด ระบุเองได้ เช่น
# KIOS_FIELD_MAP={"plate":"car_license","province":"province","driver_name":"driver_name","checkin_at":"checkin_datetime"}
